{
  "schema": 1,
  "id": "pixel",
  "ambient": {
    "topFade": { "style": "steps", "color": "$bg" },
    "layers": [
      {
        "type": "grid",
        "gap": 18, "color": "$line", "alpha": 0.10,
        "stroke": 1, "drift": false, "chunky": true
      },
      {
        "type": "starfield",
        "color": "$accent", "color2": "$accent2", "px": 4,
        "bands": [
          { "count": 34, "speed": 1.0, "size": 4, "alpha": 0.55 },
          { "count": 22, "speed": 0.5, "size": 6, "alpha": 0.8 }
        ]
      },
      {
        "type": "band_step",
        "color": "$accent", "px": 4, "speedFactor": 1.3,
        "alpha": 0.14, "echoAlpha": 0.08
      },
      {
        "type": "brackets",
        "style": "rect", "margin": 6, "arm": 26, "thickness": 4,
        "color": "$text", "alpha": 0.28, "safeTop": true
      }
    ]
  },
  "overlay": { "layers": [] },
  "scanline": { "gap": 4, "color": "#29000000", "animated": false },
  "pull": { "style": "pixel", "colorA": "$accent" }
}
