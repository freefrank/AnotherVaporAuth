  "scanline": { "gap": 3, "color": "#0D00F0FF", "animated": true },
  "pull": {
    "style": "neon",
    "colorA": "#18E0FF", "colorB": "#FF1B6B",
    "lineA": "#00FFFF", "lineB": "#FF2BD6"
  }
