      {
        "type": "labels",
        "color": "#18E0FF", "fontSize": 9,
        "fontFamily": "JetBrainsMono", "letterSpacing": 1.5,
        "items": [
          { "text": "AVA//NET", "anchor": "tl", "dx": 14, "dy": 34 },
          { "text": "SECURE", "anchor": "br", "dx": -14, "dy": -44 }
        ]
      },
      { "type": "rec_dot", "text": "REC", "color": "#FF1B6B", "anchor": "tr", "dx": -24, "dy": 38 }
    ]
