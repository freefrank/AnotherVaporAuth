// AVA entitlement service: Pro-subscription backend (Play / Afdian / beta
// codes / AdMob rewarded VIP) issuing Ed25519-signed 24h JWTs.
//
// Placeholder ids below — fill in after `wrangler d1 create` /
// `wrangler kv namespace create` (see README.md).
//
// Secrets (npx wrangler secret put <NAME>):
//   ENTITLEMENT_SIGNING_KEY  base64 PKCS#8 Ed25519 private key
//   AFDIAN_USER_ID           Afdian open-platform user_id
//   AFDIAN_TOKEN             Afdian open-platform API token
//   AFDIAN_PLAN_ID           the Pro plan's plan_id
//   GOOGLE_SA_EMAIL          Play service-account client_email
//   GOOGLE_SA_KEY            Play service-account private key (PEM or base64 PKCS#8)
//   PLAY_PACKAGE_NAME        pro.dotslash.ava
//   GOOGLE_CLIENT_ID         Web OAuth client id; id_token `aud` is pinned to
//                            it and verification fails outright when unset
{
  "name": "ava-entitlement",
  // Explicit rather than inferred. It is NOT the cure for the 7403
  // "not authorized" that wrangler returns on an expired OAuth token —
  // that one is fixed by any command refreshing the token, and remote
  // calls work fine without this line (measured).
  "account_id": "a6f98d533d0a0c22b3fdaded5cd8b8b2",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // workers.dev serving is broken on this account (see feedback-worker), so
  // the API lives on a custom domain instead:
  "workers_dev": false,
  "routes": [{ "pattern": "api.ava.dotslash.pro", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ava-entitlement",
      "database_id": "6f949ca5-90b5-46d2-8db0-abce6f3eeb19",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "448b3b50a1e4469e99d20ff058f44486"
    }
  ],
  // Per-IP brake on the redeem endpoints (see RATE_LIMITED in router.ts).
  // `period` may only be 10 or 60. 8/minute is far above any human entering a
  // code by hand and far below a useful guessing rate. `namespace_id` is a
  // local counter id, not an account resource — it only has to be unique
  // within this Worker.
  "ratelimits": [
    {
      "name": "REDEEM_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
